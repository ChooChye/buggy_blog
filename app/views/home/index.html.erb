<% content_for :title, "Buggy Blog" %>

<section class="hero">
  <h1>Welcome to Buggy Blog</h1>
  <p>A small blog about technology, food, and travel.</p>
  <p>
    <%= link_to "Browse all articles", articles_path, class: "button" %>
    <%= link_to "Browse categories", categories_path, class: "button button-secondary" %>
  </p>
  <p class="muted">
    <%= pluralize(@article_count, "article") %> in <%= pluralize(@category_count, "category") %>.
  </p>
</section>

<% content_for :title, "Categories" %>

<div class="page-header">
  <h1>Categories</h1>
  <%= link_to "New category", new_category_path, class: "button" %>
</div>

<% if @categories.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Articles</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= link_to category.name, articles_category_path(category) %></td>
          <td><%= category.articles.count %></td>
          <td class="row-actions">
            <%= link_to "Edit", edit_category_path(category) %>
            <%= button_to "Delete", category, method: :delete, class: "link-button",
                  form: { onsubmit: "return confirm('Delete this category?');" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No categories yet.</p>
<% end %>

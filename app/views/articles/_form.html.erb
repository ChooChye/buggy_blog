<%= form_with model: article, class: "form" do |form| %>
  <% if article.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(article.errors.count, "error") %> prevented this article from being saved:</h2>
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :category_id, "Category" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name %>
  </div>

  <div class="field">
    <%= form.label :status %>
    <%= form.select :status, Article.statuses.keys.map { |status| [ status.humanize, status ] } %>
  </div>

  <div class="field">
    <%= form.label :slug %>
    <%= form.text_field :slug %>
    <p class="hint">Used in the article URL. Leave blank to generate it from the title.</p>
  </div>

  <div class="field">
    <%= form.label :body %>
    <%= form.text_area :body, rows: 10 %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
  </div>
<% end %>

<% content_for :title, "Articles" %>

<div class="page-header">
  <h1>Articles</h1>
  <%= link_to "New article", new_article_path, class: "button" %>
</div>

<%= form_with url: articles_path, method: :get, class: "search-form" do |form| %>
  <%= form.label :q, "Search by title", class: "visually-hidden" %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search by title" %>
  <%= form.submit "Search", name: nil, class: "button button-secondary" %>
  <% if params[:q].present? %>
    <%= link_to "Clear", articles_path %>
  <% end %>
<% end %>

<% if @articles.present? %>
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Status</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @articles.each do |article| %>
        <tr>
          <td><%= link_to article.title, article %></td>
          <td><%= category_link(article.category) %></td>
          <td><%= status_badge(article) %></td>
          <td><%= display_date(article.created_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif params[:q].present? %>
  <p class="empty">No articles match &ldquo;<%= params[:q] %>&rdquo;.</p>
<% else %>
  <p class="empty">No articles yet. <%= link_to "Write the first one", new_article_path %>.</p>
<% end %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Buggy Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Buggy Blog">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "Buggy Blog", root_path, class: "brand" %>
        <nav>
          <%= link_to "Articles", articles_path %>
          <%= link_to "Categories", categories_path %>
          <%= link_to "New article", new_article_path, class: "button button-small" %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <p class="flash flash-notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash flash-alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
